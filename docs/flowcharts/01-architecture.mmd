%% Vertical layout; Etherscan = ABI only; RPC = internal trace to parent tx
flowchart TD
  subgraph chain["On-chain"]
    RPCNODE["Node / Alchemy"]
  end

  subgraph notify["Alchemy Notify"]
    WH["Webhook delivery"]
  end

  RPCNODE -->|"subscribed data"| WH

  subgraph mon["Monitor service"]
    SRV["Express : /webhook"]
    SIG["Verify signature + route config"]
    HND["handlers: parse & match"]
    RE["rules-engine"]
    TG["telegram module"]
  end

  subgraph ext["External APIs when needed"]
    ES["Etherscan V2: contract getabi only"]
    DBG["JSON-RPC: debug_traceBlockByNumber + block #"]
  end

  WH -->|"HTTPS POST + signature"| SRV
  SRV --> SIG --> HND --> RE
  RE -->|"optional"| TG
  HND --> ES
  HND --> DBG

  User["Ops / developer"]
  TGAPI["Telegram API"]

  HND -->|"console logs"| User
  TG -->|"HTTPS"| TGAPI
